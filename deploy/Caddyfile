# Caddy terminates TLS and proxies to the app container. Certificates are
# obtained and renewed from Let's Encrypt automatically on first request for
# the domain -- there is no certbot cron to forget about.

{$SITE_DOMAIN} {
	encode zstd gzip

	# Next.js fingerprints these filenames, so they are safe to cache hard.
	@immutable path /_next/static/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	reverse_proxy app:3000 {
		health_uri /healthz
		health_interval 10s
		health_timeout 3s
	}
}

# Redirect the apex/www variant to the canonical host.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
