# Caddy terminates TLS and proxies to the app container. Certificates are
# obtained and renewed from Let's Encrypt automatically on first request for
# the domain -- there is no certbot cron to forget about.

{$SITE_DOMAIN} {
	encode zstd gzip

	# Next.js fingerprints these filenames, so they are safe to cache hard.
	@immutable path /_next/static/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	reverse_proxy app:3000 {
		health_uri /healthz
		health_interval 10s
		health_timeout 3s
	}

	# If the Cloudflare orange cloud is switched on, every request arrives from
	# a Cloudflare edge IP and access logs record that instead of the visitor.
	# Uncomment to restore real client IPs from CF-Connecting-IP. Ranges are
	# published at https://www.cloudflare.com/ips/ and do change occasionally.
	#
	# trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 \
	#   103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 \
	#   188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 \
	#   104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
}

# Redirect the apex/www variant to the canonical host.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
